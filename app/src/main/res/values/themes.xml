<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= 基础主题：无 ActionBar + 沉浸状态栏 ================= -->
    <style name="Theme.Minesweeper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 品牌色 -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent_2</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/on_accent</item>

        <!-- 窗口 -->
        <item name="android:windowBackground">@color/bg_base</item>
        <!-- 状态栏透明，内容延伸到状态栏下方（沉浸态） -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- 弹窗圆角 -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Minesweeper.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Minesweeper.AlertDialog</item>
    </style>

    <!-- 状态栏图标深浅由代码按深色模式切换（ImmersiveUtils），此处保证首帧与浅色一致 -->
    <style name="Theme.Minesweeper.NoSplash">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 设置页：浮动卡片式对话框窗口 -->
    <style name="Theme.Minesweeper.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <!-- ================= 弹窗样式 ================= -->
    <style name="ThemeOverlay.Minesweeper.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Minesweeper.Dialog</item>
    </style>

    <style name="ShapeAppearance.Minesweeper.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ================= 按钮 ================= -->
    <style name="Widget.Minesweeper.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/btn_text_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="backgroundTint">@color/btn_tint_primary</item>
        <item name="cornerRadius">28dp</item>
        <item name="elevation">5dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.Minesweeper.Button.Primary.Small" parent="Widget.Minesweeper.Button.Primary">
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="Widget.Minesweeper.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/btn_text_secondary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="backgroundTint">@color/btn_tint_secondary</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#2214B8A6</item>
    </style>

    <style name="Widget.Minesweeper.Button.Secondary.Small" parent="Widget.Minesweeper.Button.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- ================= 文本 ================= -->
    <style name="Text.Minesweeper.Title" parent="">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Minesweeper.Label" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.28</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="Text.Minesweeper.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>
</resources>
