<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="扫雷游戏操作说明"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="基本规则："
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="· 游戏开始时，所有格子都是隐藏的\n· 点击格子可以揭示其内容\n· 数字表示周围8个格子中地雷的数量\n· 长按格子可以标记地雷\n· 避免点击地雷，揭示所有非地雷格子即可获胜"
                android:textSize="15sp"
                android:gravity="left"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="操作方式："
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="· 单击：揭示格子\n· 长按：标记/取消标记地雷\n· 双击：快速揭示周围未标记的格子"
                android:textSize="15sp"
                android:gravity="left"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="难度说明："
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="· 初级：9×9格子，10个地雷\n· 中级：16×16格子，40个地雷\n· 高级：18×28格子，99个地雷"
                android:textSize="15sp"
                android:gravity="left"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="提示："
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="· 游戏开始时的第一次点击不一定是安全的哦！\n· 使用标记功能可以帮助你记住可能的地雷位置\n· 双击功能可以快速揭示周围安全的格子\n· 注意观察数字提示，合理推理地雷位置"
                android:textSize="15sp"
                android:gravity="left"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="返回"
        android:layout_marginTop="20dp"/>

</LinearLayout> 